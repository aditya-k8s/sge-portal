# Shri Gouri Engineers -- environment configuration
#
# Copy this file to .env and fill in the values for your machine:
#     cp .env.example .env
#
# .env is git-ignored and must never be committed. Real environment variables
# always override anything set here, so the same code runs unchanged in
# development, staging and production.

# -- Django -------------------------------------------------------------------
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Required whenever DEBUG=False.
SECRET_KEY=

# Never enable DEBUG on a public host.
DEBUG=True

# Comma-separated. A wildcard is rejected when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Needed once the site is served over HTTPS, and for PWA install testing from
# a phone via a tunnel. Include the scheme, e.g.
# CSRF_TRUSTED_ORIGINS=https://sge.example.com,https://abc123.ngrok-free.app
CSRF_TRUSTED_ORIGINS=

# Sub-path the app is mounted on. Leave empty to serve at the domain root.
# Set to /web to serve at https://example.com/web/ behind a reverse proxy.
SCRIPT_PREFIX=

TIME_ZONE=Asia/Kolkata

# Absolute base URL, used in outgoing email links.
SITE_URL=http://127.0.0.1:8000

# -- Database -----------------------------------------------------------------
# mongodb (default) | mysql | postgresql | sqlite
# The migrations in apps/*/migrations are generated for MongoDB and use
# ObjectId primary keys; switching to a SQL engine means regenerating them.
DB_ENGINE=mongodb

# MongoDB only, and required when DB_ENGINE=mongodb. The whole connection
# string, including credentials and options. From Atlas: Connect > Drivers.
# A local server is mongodb://127.0.0.1:27017.
MONGODB_URI=

# Path to the SQLite file, used only when DB_ENGINE=sqlite. Defaults to
# db.sqlite3 in the project root. DB_NAME below is the database name for
# MongoDB, MySQL and PostgreSQL, and is not used by the SQLite backend.
# SQLITE_NAME=
DB_NAME=sge_portal
DB_USER=sge_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Seconds a connection is reused between requests. 0 disables pooling.
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

# Managed MySQL providers (Aiven, RDS, TiDB) require TLS. Point this at the CA
# certificate file they give you. Leave empty for a local server.
DB_SSL_CA=

# Fallback when placing the CA file on the host is impractical: encrypts the
# connection WITHOUT verifying the server certificate. Prefer DB_SSL_CA.
# DB_SSL=False

# PostgreSQL only: disable | require | verify-ca | verify-full
DB_SSLMODE=

# The test suite runs against DB_ENGINE. Django creates and drops a separate
# test database, so the configured one is never touched.

# -- Email --------------------------------------------------------------------
# With DEBUG=True the console backend is used automatically and no credentials
# are needed -- messages are printed to the terminal.
# For real sending, set the backend and the SMTP credentials below.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
# For Gmail this is a 16-character App Password, not the account password:
# myaccount.google.com -> Security -> App passwords
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=10

# -- Company details (public site and invoice PDFs) ---------------------------
COMPANY_NAME=Shri Gouri Engineers
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_ADDRESS=
COMPANY_GSTIN=

# -- Progressive Web App ------------------------------------------------------
PWA_APP_NAME=Shri Gouri Engineers
PWA_APP_SHORT_NAME=SGE Portal
PWA_APP_DESCRIPTION=Project tracking portal for Shri Gouri Engineers precision machining clients.

# -- Limits and paging --------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
PAGE_SIZE=20
API_PAGE_SIZE=20
SESSION_COOKIE_AGE=1209600

# -- Logging ------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Writes rotating logs to logs/app.log. Defaults to on when DEBUG=False.
LOG_TO_FILE=False
# Set to DEBUG to log every SQL query. Very noisy.
DB_LOG_LEVEL=WARNING

# -- HTTPS (applied only when DEBUG=False) ------------------------------------
# Leave these at their defaults unless TLS terminates somewhere unusual.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False
